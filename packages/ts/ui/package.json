{
  "name": "@restpos/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de diseño estilo iOS: tokens, componentes CSS e iconos semánticos (F0-12)",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./tailwind.css": "./src/tailwind.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
