{
  "$comentario": "Fuente única del sistema de diseño (F0-12). Genera CSS, TypeScript y Dart con `make tokens`. No edites los archivos generados.",
  "color": {
    "$comentario": "Cada color tiene valor claro y oscuro. Los «tint» son los colores vivos de iOS para fondos, iconos y mosaicos; los «text»/«accent» son sus variantes accesibles (WCAG AA) para texto y botones.",
    "background":      { "light": "#F2F2F7", "dark": "#000000", "uso": "Fondo agrupado de pantallas y listas" },
    "surface":         { "light": "#FFFFFF", "dark": "#1C1C1E", "uso": "Celdas, tarjetas y listas agrupadas" },
    "surfaceRaised":   { "light": "#FFFFFF", "dark": "#2C2C2E", "uso": "Hojas, popovers y elementos sobre una superficie" },
    "fill":            { "light": "rgba(118,118,128,0.12)", "dark": "rgba(120,120,128,0.24)", "uso": "Campos de búsqueda, controles segmentados, botones secundarios" },
    "fillSubtle":      { "light": "rgba(118,118,128,0.08)", "dark": "rgba(120,120,128,0.16)", "uso": "Hover y filas presionadas" },
    "separator":       { "light": "rgba(60,60,67,0.29)", "dark": "rgba(84,84,88,0.6)", "uso": "Separadores finos (0,5 px) de listas" },
    "label":           { "light": "#000000", "dark": "#FFFFFF", "uso": "Texto principal" },
    "labelSecondary":  { "light": "#636366", "dark": "#AEAEB2", "uso": "Texto secundario, subtítulos. Más oscuro que iOS para cumplir AA" },
    "labelTertiary":   { "light": "#AEAEB2", "dark": "#636366", "uso": "Solo marcadores de posición y estados deshabilitados (exentos de AA)" },
    "accent":          { "light": "#0066CC", "dark": "#409CFF", "uso": "Enlaces, acciones de texto, iconos interactivos" },
    "accentFill":      { "light": "#0066CC", "dark": "#0071E3", "uso": "Fondo del botón principal" },
    "onAccent":        { "light": "#FFFFFF", "dark": "#FFFFFF", "uso": "Texto sobre accentFill" },
    "successText":     { "light": "#1B7A33", "dark": "#30D158", "uso": "Texto de éxito, «Cuadrado», «Autorizado»" },
    "warningText":     { "light": "#B34700", "dark": "#FF9F0A", "uso": "Texto de advertencia, «Queda poco»" },
    "dangerText":      { "light": "#D70015", "dark": "#FF6961", "uso": "Texto de error, acciones destructivas, «Faltante»" },
    "dangerFill":      { "light": "#D70015", "dark": "#D70015", "uso": "Fondo del botón destructivo y del swipe para borrar" },
    "onDanger":        { "light": "#FFFFFF", "dark": "#FFFFFF", "uso": "Texto sobre dangerFill" },
    "successSoft":     { "light": "#E6F6EA", "dark": "#173D22", "uso": "Fondo de píldoras y avisos de éxito" },
    "warningSoft":     { "light": "#FFF1E0", "dark": "#3D2C12", "uso": "Fondo de píldoras y avisos de advertencia" },
    "dangerSoft":      { "light": "#FDE8EA", "dark": "#3F1B1B", "uso": "Fondo de píldoras y avisos de error" },
    "accentSoft":      { "light": "#E5F0FB", "dark": "#10283F", "uso": "Fondo de botones teñidos y selección suave" },
    "switchOn":        { "light": "#34C759", "dark": "#30D158", "uso": "Toggle activado (no lleva texto)" },
    "bar":             { "light": "rgba(249,249,249,0.8)", "dark": "rgba(22,22,24,0.74)", "uso": "Barras de navegación y pestañas translúcidas" },
    "scrim":           { "light": "rgba(0,0,0,0.28)", "dark": "rgba(0,0,0,0.55)", "uso": "Fondo detrás de una hoja modal" }
  },
  "tint": {
    "$comentario": "Colores de sistema de iOS. Para fondos, iconos, gráficos y mosaicos, nunca como color de texto pequeño.",
    "blue":   { "light": "#007AFF", "dark": "#0A84FF" },
    "green":  { "light": "#34C759", "dark": "#30D158" },
    "orange": { "light": "#FF9500", "dark": "#FF9F0A" },
    "red":    { "light": "#FF3B30", "dark": "#FF453A" },
    "yellow": { "light": "#FFCC00", "dark": "#FFD60A" },
    "indigo": { "light": "#5856D6", "dark": "#5E5CE6" },
    "purple": { "light": "#AF52DE", "dark": "#BF5AF2" },
    "teal":   { "light": "#30B0C7", "dark": "#40C8E0" },
    "pink":   { "light": "#FF2D55", "dark": "#FF375F" },
    "gray":   { "light": "#8E8E93", "dark": "#98989D" }
  },
  "mesa": {
    "$comentario": "Estados de mesa (RF-03-02). Mismo significado en app, caja y dashboard. fg está elegido para AA sobre bg.",
    "libre":     { "bg": { "light": "#34C759", "dark": "#30D158" }, "fg": { "light": "#062E12", "dark": "#062E12" }, "icono": "libre" },
    "ocupada":   { "bg": { "light": "#FFCC00", "dark": "#FFD60A" }, "fg": { "light": "#3A2A00", "dark": "#3A2A00" }, "icono": "ocupada" },
    "porPagar":  { "bg": { "light": "#0066CC", "dark": "#0071E3" }, "fg": { "light": "#FFFFFF", "dark": "#FFFFFF" }, "icono": "factura" },
    "bloqueada": { "bg": { "light": "#636366", "dark": "#48484A" }, "fg": { "light": "#FFFFFF", "dark": "#FFFFFF" }, "icono": "bloqueo" },
    "demorada":  { "bg": { "light": "#D70015", "dark": "#D70015" }, "fg": { "light": "#FFFFFF", "dark": "#FFFFFF" }, "icono": "tiempo" }
  },
  "contraste": {
    "$comentario": "Pares texto/fondo que la prueba verifica en ambos temas. 4.5 = texto normal (AA), 3 = texto grande o elementos gráficos.",
    "pares": [
      ["label", "background", 4.5], ["label", "surface", 4.5], ["label", "surfaceRaised", 4.5],
      ["labelSecondary", "background", 4.5], ["labelSecondary", "surface", 4.5], ["labelSecondary", "surfaceRaised", 4.5],
      ["accent", "background", 4.5], ["accent", "surface", 4.5], ["accent", "surfaceRaised", 4.5],
      ["onAccent", "accentFill", 4.5], ["onDanger", "dangerFill", 4.5],
      ["successText", "surface", 4.5], ["warningText", "surface", 4.5], ["dangerText", "surface", 4.5],
      ["successText", "background", 4.5], ["warningText", "background", 4.5], ["dangerText", "background", 4.5],
      ["label", "fill@surface", 4.5], ["switchOn", "surface", 1.5],
      ["successText", "successSoft", 4.5], ["warningText", "warningSoft", 4.5], ["dangerText", "dangerSoft", 4.5], ["accent", "accentSoft", 4.5]
    ]
  },
  "font": {
    "family": { "text": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI Variable\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
                "display": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Segoe UI Variable Display\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
                "mono": "\"SF Mono\", ui-monospace, \"Cascadia Mono\", Menlo, Consolas, monospace" },
    "scale": {
      "$comentario": "Escala tipográfica de iOS (Dynamic Type, tamaño Large). size/line en px, tracking en em.",
      "largeTitle": { "size": 34, "line": 41, "weight": 700, "tracking": -0.022 },
      "title1":     { "size": 28, "line": 34, "weight": 700, "tracking": -0.021 },
      "title2":     { "size": 22, "line": 28, "weight": 700, "tracking": -0.016 },
      "title3":     { "size": 20, "line": 25, "weight": 600, "tracking": -0.017 },
      "headline":   { "size": 17, "line": 22, "weight": 600, "tracking": -0.024 },
      "body":       { "size": 17, "line": 22, "weight": 400, "tracking": -0.024 },
      "callout":    { "size": 16, "line": 21, "weight": 400, "tracking": -0.019 },
      "subhead":    { "size": 15, "line": 20, "weight": 400, "tracking": -0.014 },
      "footnote":   { "size": 13, "line": 18, "weight": 400, "tracking": -0.005 },
      "caption1":   { "size": 12, "line": 16, "weight": 400, "tracking": 0 },
      "caption2":   { "size": 11, "line": 13, "weight": 400, "tracking": 0.006 },
      "amount":     { "size": 48, "line": 52, "weight": 700, "tracking": -0.03, "uso": "Totales de cobro y teclados numéricos" }
    }
  },
  "space":  { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "radius": { "xs": 6, "sm": 8, "md": 10, "lg": 12, "xl": 14, "widget": 22, "phone": 44, "pill": 999 },
  "size":   { "touchMin": 48, "cellMin": 52, "navBar": 52, "tabBar": 56, "keypadKey": 76, "appIcon": 60 },
  "motion": {
    "fast": 150, "base": 250, "sheet": 420,
    "easeStandard": "cubic-bezier(0.2, 0.9, 0.25, 1)",
    "easeSpring":   "cubic-bezier(0.3, 1.3, 0.5, 1)"
  },
  "material": { "blur": 20, "saturate": 1.8 },
  "shadow": {
    "card":  "0 1px 2px rgba(0,0,0,0.04), 0 8px 28px rgba(0,0,0,0.06)",
    "sheet": "0 -10px 40px rgba(0,0,0,0.18)",
    "thumb": "0 3px 8px rgba(0,0,0,0.15), 0 1px 1px rgba(0,0,0,0.16)"
  }
}
