{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restpos/contracts/events/fiscal.status_changed.json",
  "title": "fiscal.status_changed",
  "description": "Cambió el estado de un comprobante electrónico.",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "invoice_id": {
      "type": "string",
      "format": "uuid"
    },
    "access_key": {
      "type": "string",
      "description": "Clave de acceso de 49 dígitos"
    },
    "status": {
      "type": "string",
      "enum": [
        "EMITIDO",
        "ENVIADO",
        "AUTORIZADO",
        "NO_AUTORIZADO",
        "REQUIERE_ATENCION",
        "ANULADO"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "invoice_id",
    "status"
  ]
}
