{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restpos/contracts/events/table.locked.json",
  "title": "table.locked",
  "description": "La mesa quedó bloqueada por un mesero (nadie más puede editarla).",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "table_id": {
      "type": "string",
      "format": "uuid"
    },
    "by_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "by_name": {
      "type": "string",
      "description": "Nombre visible del mesero"
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Vence si no llega heartbeat (45 s)"
    }
  },
  "required": [
    "table_id",
    "by_user_id",
    "by_name",
    "expires_at"
  ]
}
