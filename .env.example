# Copia a .env solo si necesitas cambiar las credenciales locales de `make dev`.
# Son de desarrollo: jamás uses estos valores en otro entorno.
POSTGRES_PASSWORD=restpos_dev
APP_DB_PASSWORD=restpos_app_dev
S3_ACCESS_KEY=restpos
S3_SECRET_KEY=restpos_s3_dev

# Puertos del host (cámbialos si chocan con otros proyectos)
PG_PORT=5442
S3_PORT=7171
AZURITE_PORT=10010

# Para probar la API contra Azurite en lugar de VersityGW (la clave es la pública y documentada del emulador):
# STORAGE_DRIVER=azure
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10010/devstoreaccount1;
