/bin/
*.exe
*.test
coverage.out
coverage.html

# Node / web
node_modules/
dist/
.vite/
*.tsbuildinfo
e2e/cypress/screenshots/
e2e/cypress/videos/
e2e/cypress/downloads/

# Flutter / Dart
.dart_tool/
build/
