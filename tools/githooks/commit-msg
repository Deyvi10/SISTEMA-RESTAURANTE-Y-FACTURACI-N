#!/usr/bin/env bash
# Conventional Commits con los scopes del proyecto (docs/11 §7).
msg=$(head -1 "$1")
re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\((cloud|edge|waiter|pos|backoffice|kds|menu|sri|contracts|db|docs|ci|tools|deps)\))?!?: .{1,100}$'
if [[ "$msg" =~ ^(Merge|Revert|fixup!|squash!) ]] || [[ "$msg" =~ $re ]]; then exit 0; fi
cat >&2 <<MSG
✗ El mensaje no sigue Conventional Commits:
    $msg
  Formato: tipo(scope): descripción
  Ejemplo: feat(edge): table locking with heartbeat
  Scopes:  cloud edge waiter pos backoffice kds menu sri contracts db docs ci tools deps
MSG
exit 1
